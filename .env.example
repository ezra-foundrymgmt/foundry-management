# Local development defaults to deterministic mock integrations.
CREATOROS_INTEGRATION_MODE=mock
APP_ENV=development
NEXT_PUBLIC_CREATOROS_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Prefer Supabase's current secret-key format. Legacy projects may temporarily use the fallback.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_SIGNING_KEY_FALLBACK=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/integrations/notion/callback
# 32-byte base64 key used to encrypt provider access tokens before database storage.
INTEGRATION_ENCRYPTION_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SENTRY_DSN=
